#!/bin/bash

DATA_DIR="${TRIM_DATA_SHARE_PATHS%%:*}"
LOG_FILE="${DATA_DIR}/run.log"
PID_FILE="${TRIM_PKGVAR}/app.pid"
ENV_FILE="${TRIM_APPDEST}/server/.env"

DP_STORAGE_LOCAL_PATH="${DATA_DIR}/data"
APP_SERVER_SOCKET="${TRIM_APPDEST}/dpanel.sock"

DPANEL_BIN="${TRIM_APPDEST}/server/dpanel"
DPANEL_ENV=(
    "APP_NAME=dpanel"
    "APP_SERVER_HOST=0.0.0.0"
    "APP_SERVER_PORT=${DP_APP_SERVER_PORT}"
    "APP_ENV=lite"
    "APP_FAMILY=ce"
    "APP_DEV=false"
    "STORAGE_LOCAL_PATH=${DP_STORAGE_LOCAL_PATH}"
    "APP_SERVER_SOCKET=${APP_SERVER_SOCKET}"
    "DP_RUN_IN_FNNAS=1"
    "DP_SYSTEM_BASEURL=/app/dpanel"
    "INSTALLER_BASE_IMAGE=debian"
    "SHELL=/bin/bash"
    "HOME=${DP_STORAGE_LOCAL_PATH}"
    "USER=${TRIM_RUN_USERNAME}"
    "LOGNAME=${TRIM_RUN_USERNAME}"
    "PATH=/usr/local/bin:/usr/bin:/bin:/usr/local/sbin:/usr/sbin:/sbin"
    "LANG=en_US.UTF-8"
    "LANGUAGE=en_US:en"
    "TERM=xterm-256color"
    "COLORTERM=truecolor"
)

log_msg() {
    echo "$(date '+%Y-%m-%d %H:%M:%S') - $1" >> "${LOG_FILE}"
}

mask_password() {
    local value="$1"
    local length=${#value}
    if [ "${length}" -le 2 ]; then
        printf "***"
        return
    fi
    printf "%s***%s" "${value:0:1}" "${value: -1}"
}

build_dpanel_args() {
    DPANEL_ARGS=()
    local env
    for env in "${DPANEL_ENV[@]}"; do
        DPANEL_ARGS+=(-e "${env}")
    done
}

write_env_file() {
    mkdir -p "$(dirname "${ENV_FILE}")"
    printf "%s\n" "${DPANEL_ENV[@]}" > "${ENV_FILE}"
    chmod 600 "${ENV_FILE}"
}

terminate_process() {
    local pid=$1

    if [ -z "${pid}" ] || ! check_process "${pid}"; then
        return 0
    fi

    log_msg "send TERM signal to PID:${pid}..."
    kill -TERM "${pid}" >> "${LOG_FILE}" 2>&1

    local count=0
    while check_process "${pid}" && [ $count -lt 10 ]; do
        sleep 1
        count=$((count + 1))
        log_msg "waiting process terminal... (${count}s/10s)"
    done

    if check_process "${pid}"; then
        log_msg "send KILL signal to PID:${pid}..."
        kill -KILL "${pid}" >> "${LOG_FILE}" 2>&1
        sleep 1
    else
        log_msg "process killed... "
    fi
}

cleanup_existing_process() {
    if command -v pgrep >/dev/null 2>&1; then
        pids=$(pgrep -f "${TRIM_APPDEST}/server/dpanel")
        for pid in ${pids}; do
            [ "${pid}" = "$$" ] && continue
            log_msg "cleanup existing dpanel process pid=${pid}"
            terminate_process "${pid}"
        done
    fi

    rm -f "${APP_SERVER_SOCKET}"
    rm -f "${PID_FILE}"
}

start_process() {
    # 安装向导参数只在本脚本中用于初始化用户。DPanel 会在 DEBUG
    # 日志中输出完整子进程环境，因此不能让它们继续被子进程继承。
    local init_username="${DP_INIT_USERNAME:-}"
    local init_password="${DP_INIT_PASSWORD:-}"
    unset DP_INIT_USERNAME DP_INIT_PASSWORD

    log_msg "============== Debug Info =============="
    log_msg "[Sys] ID: ${TRIM_SYS_MACHINE_ID:--}"
    log_msg "[Sys] 用户: ${TRIM_RUN_USERNAME:--}:${TRIM_RUN_GROUPNAME:--} (${TRIM_RUN_UID:--}:${TRIM_RUN_GID:--})"
    log_msg "[Sys] 版本: ${TRIM_SYS_VERSION:--}"
    log_msg "[Sys] 架构: ${TRIM_SYS_ARCH:--}"
    log_msg "[Sys] 内核: ${TRIM_KERNEL_VERSION:--}"
    log_msg "[Sys] 语言: ${TRIM_SYS_LANGUAGE:--}"
    log_msg "[Sys] 动态数据: ${TRIM_PKGVAR:--}"
    log_msg "[Sys] 临时文件: ${TRIM_PKGTMP:--}"
    log_msg "[Sys] 用户数据: ${TRIM_PKGHOME:--}"
    log_msg "[Sys] 元数据: ${TRIM_PKGMETA:--}"
    log_msg "[Sys] 日志文件: ${TRIM_TEMP_LOGFILE:--}"
    log_msg "[Sys] 升级临时: ${TRIM_TEMP_UPGRADE_FOLDER:--}"
    log_msg "[Sys] 安装临时: ${TRIM_PKGINST_TEMP_DIR:--}"
    log_msg "[Sys] FPK解压: ${TRIM_TEMP_TPKFILE:--}"
    log_msg "===================================="
    log_msg "[App] 用户: ${TRIM_USERNAME:--}:${TRIM_GROUPNAME:--} (${TRIM_UID:--}:${TRIM_GID:--})"
    log_msg "[App] 名称: ${TRIM_APPNAME:--}"
    log_msg "[App] 版本: ${TRIM_APPVER:--}"
    log_msg "[App] 状态: ${TRIM_APP_STATUS:--}"
    log_msg "[App] 端口: ${TRIM_SERVICE_PORT:--}"
    log_msg "[App] 工作目录: ${TRIM_APPDEST:--}"
    log_msg "[App] 配置文件: ${TRIM_PKGETC:--}"
    log_msg "[App] 存储空间: ${TRIM_APPDEST_VOL:--}"
    log_msg "[App] 共享目录: ${TRIM_DATA_SHARE_PATHS:--}"

    log_msg "Starting process ..."
    # run cmd to start process
    export PATH="/usr/local/bin:/usr/bin:/bin:$PATH"
    cleanup_existing_process
    build_dpanel_args
    write_env_file
    "${DPANEL_BIN}" "${DPANEL_ARGS[@]}" server:start >> "${LOG_FILE}" 2>&1 &
    # write pid to pidfile
    PID=$!
    printf "%s\n" "${PID}" > "${PID_FILE}"
    log_msg "CMD = ${DPANEL_BIN} ${DPANEL_ARGS[*]} server:start"
    log_msg "pid = ${PID}"

    if [ -n "${init_username}" ] && [ -n "${init_password}" ]; then
        log_msg "Init user ... ${init_username}/$(mask_password "${init_password}")"
        # 最多等待 30 秒，查找是否有关键字
        MAX_RETRIES=30
        COUNT=0
        while ! grep -q "provider load" "${LOG_FILE}" && [ $COUNT -lt $MAX_RETRIES ]; do
            sleep 1
            ((COUNT++))
        done
        "${DPANEL_BIN}" "${DPANEL_ARGS[@]}" user:reset --username "${init_username}" --password "${init_password}" >> "${LOG_FILE}" 2>&1 &
    fi

    return 0
}

stop_process() {
    log_msg "Stopping process ..."

    if [ -r "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        
        log_msg "pid=${pid}"
        if ! check_process "${pid}"; then
            # process not exist, delete pidfile
            rm -f "${PID_FILE}"
            log_msg "remove pid file 1"
            return
        fi

        terminate_process "${pid}"
        rm -f "${PID_FILE}"
    fi

    return 0
}

check_process() {
    local pid=$1
    if kill -0 "${pid}" 2>/dev/null; then
        return 0  # process exist
    else
        return 1  # process not exist
    fi
}

status() {
    if [ -f "${PID_FILE}" ]; then
        pid=$(head -n 1 "${PID_FILE}" | tr -d '[:space:]')
        if check_process "${pid}"; then
            return 0
        else
            # Process is not running but pidfile exists - clean it up
            rm -f "${PID_FILE}"
        fi    
    fi

    return 1
}

case $1 in
start)
    # run start command. exit 0 if success, exit 1 if failed
    start_process
    ;;
stop)
    # run stop command. exit 0 if success, exit 1 if failed
    stop_process
    ;;
status)
    # check application status command. exit 0 if running, exit 3 if not running
    if status; then 
        exit 0
    else 
        exit 3
    fi
    ;;
*)
    exit 1
    ;;
esac
